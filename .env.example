# ---- PostgreSQL (usado pelo docker compose) ----
POSTGRES_USER=logistics
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=logistics

# ---- Backend ----
# development | test | production
ENVIRONMENT=development
# Para rodar o backend FORA do Docker (aponta para o Postgres do compose na sua máquina):
DATABASE_URL=postgresql+psycopg://logistics:troque-esta-senha@localhost:5432/logistics
# Gere com: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true obrigatório em produção (cookie do refresh token só trafega via HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
